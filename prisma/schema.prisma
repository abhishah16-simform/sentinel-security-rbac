// The app and migrations both connect as the postgres user (DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity (platform-level: no tenantId, no RLS)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed; see normalizeEmail().
  email           String    @unique
  firstName       String
  lastName        String
  /// argon2id hash in PHC string format.
  passwordHash    String
  emailVerifiedAt DateTime?
  /// Set while email-code MFA is on.
  mfaEnabledAt    DateTime?
  /// Logins and codes are refused until this time after too many failures; see Lockout.
  lockedUntil     DateTime?
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  emailChallenges         EmailChallenge[]
  authFailures            AuthFailure[]
  refreshChains           RefreshChain[]
  memberships             Membership[]

  @@map("users")
}

/// A single-use email verification link. Only the SHA-256 hash of the token is stored.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

enum EmailChallengePurpose {
  MFA_LOGIN
  MFA_DISABLE
  PASSWORD_RESET
}

/// A short-lived email challenge: a 6-digit code sent by email, optionally bound to an opaque
/// token the client holds (MFA login, password reset). Only hashes of the code and token are stored.
model EmailChallenge {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  purpose       EmailChallengePurpose
  tokenHash     String?               @unique
  /// The challenge (and its token) stops working at this time.
  expiresAt     DateTime
  /// SHA-256 of "<id>:<code>"; null until a code has been sent.
  codeHash      String?
  codeExpiresAt DateTime?
  /// When the current code was emailed; resends wait a minute after it.
  codeSentAt    DateTime?
  /// Wrong guesses at the current code. The code stops working after 5.
  codeAttempts  Int                   @default(0)
  usedAt        DateTime?
  createdAt     DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_challenges")
}

/// One wrong password or code, counted towards locking the account.
model AuthFailure {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  /// "password" or "code".
  kind      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("auth_failures")
}

// ---------------------------------------------------------------------------
// Sessions (platform-level: no tenantId, no RLS)
// ---------------------------------------------------------------------------

/// One login. Every refresh token issued from that login belongs to its chain;
/// revoking the chain ends the login on that device.
model RefreshChain {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  /// The Active Tenant of this login and the User's Membership in it; null until one is chosen.
  /// Not named tenantId: this table is platform-level, and a tenantId column marks a Tenant-owned table.
  activeTenantId     String?   @db.Uuid
  activeMembershipId String?   @db.Uuid
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant     Tenant?        @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  activeMembership Membership?    @relation(fields: [activeMembershipId], references: [id], onDelete: SetNull)
  tokens           RefreshToken[]

  @@index([userId])
  @@map("refresh_chains")
}

/// An opaque refresh token. Only its SHA-256 hash is stored. It works once:
/// using it sets usedAt and issues the next token in the same chain.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  chainId   String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  chain RefreshChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@index([chainId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
//
// Tenant is platform-level (the Tenant list): no RLS.
// Every Tenant-owned table has a non-null tenantId column, and its migration must
// ENABLE and FORCE ROW LEVEL SECURITY with a policy on app.tenant_id (ADR 0003).
// The startup check warns about any table with a tenantId column that lacks either.
// ---------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  refreshChains RefreshChain[]
  auditEvents   AuditEvent[]

  @@map("tenants")
}

/// Tenant-owned (RLS). Rows are visible when tenantId matches app.tenant_id, or, for a User's
/// own Memberships only, when userId matches app.user_id (used by the Tenant picker).
model Membership {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  userId        String   @db.Uuid
  isTenantAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshChains RefreshChain[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// Audit Log
//
// One table for every chain. Tenant events carry their tenantId; platform-level events (signup,
// logins before a Tenant is chosen, Platform Admin actions) have a null tenantId and form the
// platform chain. This is the one table whose tenantId may be null: RLS shows Tenant rows inside
// that Tenant's context and platform rows only when no Tenant context is set.
// ---------------------------------------------------------------------------

/// The head of one hash chain: one row per Tenant chain plus one for the platform chain. Writers
/// lock it (SELECT ... FOR UPDATE) for the length of an insert, so each chain's writes are serialized.
/// Platform-level table: it holds only sequence numbers and hashes, no Tenant data.
model AuditChainHead {
  /// "platform", or the ID of the Tenant whose chain this is.
  chain     String   @id
  /// Sequence number of the newest entry; 0 before the first.
  seq       Int
  /// Hash of the newest entry; the genesis hash before the first.
  hash      String
  updatedAt DateTime @updatedAt

  @@map("audit_chain_heads")
}

/// One Audit Log entry. Append-only: a trigger rejects UPDATE and DELETE.
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  /// Null for platform-level events.
  tenantId      String?  @db.Uuid
  eventType     String
  /// The User who acted; null when nobody is known (a failed login for an unknown email).
  actorUserId   String?  @db.Uuid
  targetType    String?
  targetId      String?
  applicationId String?  @db.Uuid
  payload       Json     @default("{}")
  createdAt     DateTime @default(now())
  /// Position in the chain, the previous entry's hash and this entry's hash. All three are null
  /// for entries that aren't chained (Access Checks).
  seq           Int?
  prevHash      String?
  hash          String?

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, seq])
  @@index([tenantId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
  @@map("audit_events")
}
