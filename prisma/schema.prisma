// The app and migrations both connect as the postgres user (DATABASE_URL).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity (platform-level: no tenantId, no RLS)
// ---------------------------------------------------------------------------

model User {
  id              String    @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed; see normalizeEmail().
  email           String    @unique
  firstName       String
  lastName        String
  /// argon2id hash in PHC string format.
  passwordHash    String
  emailVerifiedAt DateTime?
  /// Set while email-code MFA is on.
  mfaEnabledAt    DateTime?
  /// Logins and codes are refused until this time after too many failures; see Lockout.
  lockedUntil     DateTime?
  isPlatformAdmin Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  emailChallenges         EmailChallenge[]
  authFailures            AuthFailure[]
  refreshChains           RefreshChain[]
  memberships             Membership[]
  invitationsSent         Invitation[]
  roleAssignments         RoleAssignment[]         @relation("RoleAssignmentUser")
  roleAssignmentsMade     RoleAssignment[]         @relation("RoleAssignmentAssignedBy")
  roleAssignmentsRevoked  RoleAssignment[]         @relation("RoleAssignmentRevokedBy")
  accessReviewsStarted    AccessReview[]
  accessReviewDecisions   AccessReviewItem[]
  securityAlertsAbout     SecurityAlert[]          @relation("SecurityAlertSubject")
  securityAlertsCaused    SecurityAlert[]          @relation("SecurityAlertActor")
  securityAlertsAcked     SecurityAlert[]          @relation("SecurityAlertAcknowledgedBy")

  @@map("users")
}

/// A single-use email verification link. Only the SHA-256 hash of the token is stored.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

enum EmailChallengePurpose {
  MFA_LOGIN
  MFA_DISABLE
  PASSWORD_RESET
}

/// A short-lived email challenge: a 6-digit code sent by email, optionally bound to an opaque
/// token the client holds (MFA login, password reset). Only hashes of the code and token are stored.
model EmailChallenge {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  purpose       EmailChallengePurpose
  tokenHash     String?               @unique
  /// The challenge (and its token) stops working at this time.
  expiresAt     DateTime
  /// SHA-256 of "<id>:<code>"; null until a code has been sent.
  codeHash      String?
  codeExpiresAt DateTime?
  /// When the current code was emailed; resends wait a minute after it.
  codeSentAt    DateTime?
  /// Wrong guesses at the current code. The code stops working after 5.
  codeAttempts  Int                   @default(0)
  usedAt        DateTime?
  createdAt     DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_challenges")
}

/// One wrong password or code, counted towards locking the account.
model AuthFailure {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  /// "password" or "code".
  kind      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("auth_failures")
}

// ---------------------------------------------------------------------------
// Sessions (platform-level: no tenantId, no RLS)
// ---------------------------------------------------------------------------

/// One login. Every refresh token issued from that login belongs to its chain;
/// revoking the chain ends the login on that device.
model RefreshChain {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  /// The Active Tenant of this login and the User's Membership in it; null until one is chosen.
  /// Not named tenantId: this table is platform-level, and a tenantId column marks a Tenant-owned table.
  activeTenantId     String?   @db.Uuid
  activeMembershipId String?   @db.Uuid
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant     Tenant?        @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)
  activeMembership Membership?    @relation(fields: [activeMembershipId], references: [id], onDelete: SetNull)
  tokens           RefreshToken[]

  @@index([userId])
  @@map("refresh_chains")
}

/// An opaque refresh token. Only its SHA-256 hash is stored. It works once:
/// using it sets usedAt and issues the next token in the same chain.
model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  chainId        String    @db.Uuid
  tokenHash      String    @unique
  /// The login's Active Tenant when this token was issued, kept even after the login switches or
  /// drops it: a reused token raises its Security Alert there. Not named tenantId (platform-level table).
  activeTenantId String?   @db.Uuid
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  chain        RefreshChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  activeTenant Tenant?      @relation(fields: [activeTenantId], references: [id], onDelete: SetNull)

  @@index([chainId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Tenancy
//
// Tenant is platform-level (the Tenant list): no RLS.
// Every Tenant-owned table has a non-null tenantId column, and its migration must
// ENABLE and FORCE ROW LEVEL SECURITY with a policy on app.tenant_id (ADR 0003).
// The startup check warns about any table with a tenantId column that lacks either.
// ---------------------------------------------------------------------------

model Tenant {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  /// Set while a Platform Admin has suspended the Tenant: every Access Check in it is denied.
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships         Membership[]
  invitations         Invitation[]
  refreshChains       RefreshChain[]
  refreshTokens       RefreshToken[]
  auditEvents         AuditEvent[]
  enablements         Enablement[]
  roles               Role[]
  permissions         Permission[]
  roleAssignments     RoleAssignment[]
  registeredResources RegisteredResource[]
  accessReviews       AccessReview[]
  accessReviewItems   AccessReviewItem[]
  securityAlerts      SecurityAlert[]

  @@map("tenants")
}

/// Tenant-owned (RLS). Rows are visible when tenantId matches app.tenant_id, or, for a User's
/// own Memberships only, when userId matches app.user_id (used by the Tenant picker).
model Membership {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  userId        String   @db.Uuid
  isTenantAdmin Boolean  @default(false)
  createdAt     DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshChains   RefreshChain[]
  roleAssignments RoleAssignment[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Tenant-owned (RLS). A Tenant Admin's offer of a Membership to an email address. Rows are visible
/// when tenantId matches app.tenant_id, or, for Invitations to the User's own email only, when
/// app.user_id is that User (the Invitations inbox). At most one PENDING Invitation per
/// (tenantId, email): a partial unique index in the migration.
model Invitation {
  id              String           @id @default(uuid()) @db.Uuid
  tenantId        String           @db.Uuid
  /// Stored lower-cased and trimmed; see normalizeEmail().
  email           String
  /// The Tenant Admin who sent it; null once that User is gone.
  invitedByUserId String?          @db.Uuid
  status          InvitationStatus @default(PENDING)
  /// SHA-256 of the secret part of the emailed link; replaced on every resend.
  tokenHash       String           @unique
  /// A PENDING Invitation can't be accepted after this time; resending renews it.
  expiresAt       DateTime
  /// When the email was last sent.
  sentAt          DateTime
  /// When it was accepted, declined or cancelled.
  closedAt        DateTime?
  /// The Membership that accepting it created.
  membershipId    String?          @db.Uuid
  createdAt       DateTime         @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([email, status])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Applications (platform-level: no tenantId, no RLS)
//
// Registered by Platform Admins and the same for every Tenant. Reached only through the
// applications module, which never sets a Tenant context.
// ---------------------------------------------------------------------------

/// An outside system that relies on Sentinel to log its users in and to make access decisions.
model Application {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  /// Public identifier the Application sends with its secret (HTTP Basic user name).
  clientId         String   @unique
  /// SHA-256 of the client secret. The secret itself is shown once, when issued.
  clientSecretHash String
  /// When the current secret was issued; earlier secrets stop working at that moment.
  secretIssuedAt   DateTime
  /// Browser origins (scheme://host[:port]) the Application runs on.
  allowedOrigins   String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  resourceTypes       ResourceType[]
  roleTemplates       RoleTemplate[]
  enablements         Enablement[]
  roles               Role[]
  roleAssignments     RoleAssignment[]
  registeredResources RegisteredResource[]
  accessReviews       AccessReview[]
  securityAlerts      SecurityAlert[]

  @@map("applications")
}

/// A kind of thing an Application protects (Application Schema). Never removed, only Deprecated.
model ResourceType {
  id            String    @id @default(uuid()) @db.Uuid
  applicationId String    @db.Uuid
  /// The CASL subject name, such as Document.
  name          String
  /// Set once Deprecated: no new Permissions may use it, and its Actions count as Deprecated too.
  deprecatedAt  DateTime?
  createdAt     DateTime  @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actions     Action[]

  @@unique([applicationId, name])
  @@map("resource_types")
}

/// Something a User can attempt on a Resource Type (Application Schema). Never removed, only Deprecated.
model Action {
  id             String    @id @default(uuid()) @db.Uuid
  resourceTypeId String    @db.Uuid
  /// The CASL action name, such as read or approve.
  name           String
  deprecatedAt   DateTime?
  createdAt      DateTime  @default(now())

  resourceType ResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Restrict)

  @@unique([resourceTypeId, name])
  @@map("actions")
}

/// A default Role an Application ships. Copied into a Tenant when the Tenant first enables the
/// Application; the copies are ordinary Roles and are never synced with the template afterwards.
model RoleTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  applicationId String   @db.Uuid
  /// Unique within the Application, ignoring case (checked by the service under the Application lock).
  name          String
  description   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application              @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  permissions RoleTemplatePermission[]

  @@unique([applicationId, name])
  @@map("role_templates")
}

/// One Permission in a Role Template, in CASL's raw-rule shape with string subjects (ADR 0001).
/// action and resourceType are Application Schema names; new ones may not be Deprecated.
model RoleTemplatePermission {
  id             String   @id @default(uuid()) @db.Uuid
  roleTemplateId String   @db.Uuid
  action         String
  resourceType   String
  /// true for a Deny Rule.
  inverted       Boolean  @default(false)
  createdAt      DateTime @default(now())

  roleTemplate RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Cascade)

  @@unique([roleTemplateId, resourceType, action, inverted])
  @@map("role_template_permissions")
}

// ---------------------------------------------------------------------------
// Enablement and Access Rules (Tenant-owned: tenantId, RLS)
// ---------------------------------------------------------------------------

/// Tenant-owned (RLS). A Tenant's decision to use an Application. Created the first time the
/// Tenant enables it, which is when Role Templates are copied; disabling sets disabledAt and keeps
/// the Tenant's Roles, and enabling again clears it without copying anything.
model Enablement {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  applicationId String    @db.Uuid
  /// When it was last enabled.
  enabledAt     DateTime
  /// Set while disabled; the Application is enabled exactly when this is null.
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, applicationId])
  @@map("enablements")
}

/// Tenant-owned (RLS). A named set of Permissions belonging to one Tenant and one Application.
model Role {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  applicationId String   @db.Uuid
  name          String
  description   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  permissions     Permission[]
  roleAssignments RoleAssignment[]

  @@unique([tenantId, applicationId, name])
  @@index([tenantId, applicationId])
  @@map("roles")
}

/// Tenant-owned (RLS). One rule inside a Role, in CASL's raw-rule shape with string subjects
/// (ADR 0001): an Action on a Resource Type, allowed or denied (inverted), optionally limited by a
/// Condition.
model Permission {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  roleId       String   @db.Uuid
  action       String
  resourceType String
  /// true for a Deny Rule.
  inverted     Boolean  @default(false)
  /// A CASL/Mongo-style Condition, or null for none.
  conditions   Json?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([tenantId])
  @@map("permissions")
}

/// Why a Role Assignment was revoked.
enum RoleAssignmentEndReason {
  /// A Tenant Admin revoked it.
  REVOKED
  /// Its Role was deleted.
  ROLE_DELETED
  /// Its Membership was removed or left.
  MEMBERSHIP_ENDED
  /// Still undecided when its Access Review reached the due date.
  AUTO_REVOKED
}

/// Tenant-owned (RLS). A Role given to a Membership across the whole Tenant, optionally until
/// expiresAt. Never deleted: revoking sets revokedAt, and the row outlives its Role and Membership
/// (both SET NULL; they are revoked in the same transaction first), keeping the User, Application and
/// Role name for reports and Access Reviews. Active means not revoked and expiresAt empty or later
/// than now (activeAssignmentWhere); an expired one is never marked, it simply stops counting.
model RoleAssignment {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @db.Uuid
  /// Null once the Membership is gone.
  membershipId     String?                  @db.Uuid
  /// The User the Membership belongs to; kept after the Membership ends.
  userId           String                   @db.Uuid
  /// Null once the Role is deleted.
  roleId           String?                  @db.Uuid
  applicationId    String                   @db.Uuid
  /// The Role's name when assigned, updated to its last name when the Role is deleted.
  roleName         String
  /// Null for a permanent assignment.
  expiresAt        DateTime?
  assignedByUserId String?                  @db.Uuid
  revokedAt        DateTime?
  revokedByUserId  String?                  @db.Uuid
  /// Set together with revokedAt.
  endReason        RoleAssignmentEndReason?
  /// When the Scheduler marked this Temporary Role Assignment as expired and recorded that in the
  /// Audit Log. Access never depends on it: past expiresAt the row gives no access either way.
  expiryRecordedAt DateTime?
  createdAt        DateTime                 @default(now())

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership  Membership?        @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  user        User               @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  role        Role?              @relation(fields: [roleId], references: [id], onDelete: SetNull)
  application Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  assignedBy  User?              @relation("RoleAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  revokedBy   User?              @relation("RoleAssignmentRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  reviewItems AccessReviewItem[]

  @@index([tenantId, createdAt])
  /// Access Reviews snapshot the active assignments of one Application.
  @@index([tenantId, applicationId])
  /// The expiry report and the Scheduler's expiry job.
  @@index([tenantId, expiresAt])
  @@index([membershipId])
  @@index([roleId])
  @@map("role_assignments")
}

/// Tenant-owned (RLS). A specific resource an Application has told Sentinel about, so the Tenant
/// can see who has access to it. Identified by the Application's own ID within its Resource Type;
/// written only by that Application, in a Tenant that has enabled it.
model RegisteredResource {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  applicationId String   @db.Uuid
  /// A Resource Type name in the Application Schema.
  resourceType  String
  /// The Application's own ID for the resource, as it sends in an Access Check's resource.id.
  resourceId    String
  /// The attributes Conditions are matched against, as the Application last sent them.
  attributes    Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([tenantId, applicationId, resourceType, resourceId])
  @@index([tenantId, createdAt])
  @@map("registered_resources")
}

// ---------------------------------------------------------------------------
// Access Reviews (Tenant-owned: tenantId, RLS)
// ---------------------------------------------------------------------------

enum AccessReviewStatus {
  OPEN
  CLOSED
}

/// What became of one Access Review item. Null while it is still undecided.
enum AccessReviewOutcome {
  /// A Tenant Admin Certified the Role Assignment.
  CERTIFIED
  /// A Tenant Admin revoked the Role Assignment, from the review or anywhere else.
  REVOKED
  /// Still undecided at the due date: the Scheduler revoked it.
  AUTO_REVOKED
}

/// Tenant-owned (RLS). A campaign over one Tenant and one Application in which each Role Assignment
/// active when it started is Certified or revoked by the due date. At most one OPEN review per
/// (tenantId, applicationId): a partial unique index in the migration.
model AccessReview {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  applicationId   String             @db.Uuid
  status          AccessReviewStatus @default(OPEN)
  /// Decisions stop at this time; the Scheduler then auto-revokes what is left and closes it.
  dueAt           DateTime
  /// The Tenant Admin who started it; null once that User is gone.
  startedByUserId String?            @db.Uuid
  closedAt        DateTime?
  createdAt       DateTime           @default(now())

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  application Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  startedBy   User?              @relation(fields: [startedByUserId], references: [id], onDelete: SetNull)
  items       AccessReviewItem[]

  @@index([tenantId, createdAt])
  /// The Scheduler's search for open reviews past their due date.
  @@index([tenantId, status, dueAt])
  @@map("access_reviews")
}

/// Tenant-owned (RLS). One Role Assignment snapshotted into an Access Review when it started.
model AccessReviewItem {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @db.Uuid
  reviewId         String               @db.Uuid
  roleAssignmentId String               @db.Uuid
  /// Order within the review (by member email, then Role name), and the list's page cursor.
  position         Int
  outcome          AccessReviewOutcome?
  decidedAt        DateTime?
  /// The Tenant Admin who decided it; null for AUTO_REVOKED, or once that User is gone.
  decidedByUserId  String?              @db.Uuid
  createdAt        DateTime             @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  review         AccessReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  roleAssignment RoleAssignment @relation(fields: [roleAssignmentId], references: [id], onDelete: Restrict)
  decidedBy      User?          @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([reviewId, roleAssignmentId])
  @@unique([reviewId, position])
  @@index([reviewId, outcome])
  @@index([roleAssignmentId])
  @@map("access_review_items")
}

// ---------------------------------------------------------------------------
// Audit Log
//
// One table for every chain. Tenant events carry their tenantId; platform-level events (signup,
// logins before a Tenant is chosen, Platform Admin actions) have a null tenantId and form the
// platform chain. This is the one table whose tenantId may be null: RLS shows Tenant rows inside
// that Tenant's context and platform rows only when no Tenant context is set.
// ---------------------------------------------------------------------------

/// The head of one hash chain: one row per Tenant chain plus one for the platform chain. Writers
/// lock it (SELECT ... FOR UPDATE) for the length of an insert, so each chain's writes are serialized.
/// Platform-level table: it holds only sequence numbers and hashes, no Tenant data.
model AuditChainHead {
  /// "platform", or the ID of the Tenant whose chain this is.
  chain     String   @id
  /// Sequence number of the newest entry; 0 before the first.
  seq       Int
  /// Hash of the newest entry; the genesis hash before the first.
  hash      String
  updatedAt DateTime @updatedAt

  @@map("audit_chain_heads")
}

/// One Audit Log entry. Append-only: a trigger rejects UPDATE and DELETE.
model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  /// Null for platform-level events.
  tenantId      String?  @db.Uuid
  eventType     String
  /// The User who acted; null when nobody is known (a failed login for an unknown email).
  actorUserId   String?  @db.Uuid
  targetType    String?
  targetId      String?
  applicationId String?  @db.Uuid
  payload       Json     @default("{}")
  createdAt     DateTime @default(now())
  /// Position in the chain, the previous entry's hash and this entry's hash. All three are null
  /// for entries that aren't chained (Access Checks).
  seq           Int?
  prevHash      String?
  hash          String?

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  securityAlerts SecurityAlert[]

  @@unique([tenantId, seq])
  @@index([tenantId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Security Alerts
// ---------------------------------------------------------------------------

/// The fixed detection rules. Stored by name, so never rename one.
enum SecurityAlertRule {
  /// 5 or more failed logins for a User within 15 minutes; raised in each of the User's Tenants.
  REPEATED_FAILED_LOGINS
  /// A used refresh token was presented again; raised in the Tenant the token's login had chosen.
  REFRESH_TOKEN_REUSED
  /// At least 50 denied Access Checks for one Application in one Tenant within 5 minutes.
  ACCESS_CHECK_DENIALS_SPIKE
  /// The Tenant Admin flag was given to or removed from a Membership.
  TENANT_ADMIN_CHANGED
}

/// Tenant-owned (RLS). Raised by a detection rule when an Audit Log entry is written, in the same
/// transaction; shown to the Tenant's Tenant Admins until one of them acknowledges it.
model SecurityAlert {
  id                   String            @id @default(uuid()) @db.Uuid
  tenantId             String            @db.Uuid
  rule                 SecurityAlertRule
  /// The Audit Log entry that raised it (a platform-chain entry for failed logins).
  auditEventId         String            @db.Uuid
  /// The User the alert is about: whose logins failed, whose token was reused, whose flag changed.
  subjectUserId        String?           @db.Uuid
  /// Who did it, when that is someone else (the Tenant Admin who changed the flag).
  actorUserId          String?           @db.Uuid
  applicationId        String?           @db.Uuid
  /// Rule-specific facts: counts, the window, whether the flag was given or removed.
  details              Json              @default("{}")
  createdAt            DateTime          @default(now())
  acknowledgedAt       DateTime?
  acknowledgedByUserId String?           @db.Uuid

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditEvent     AuditEvent   @relation(fields: [auditEventId], references: [id], onDelete: Restrict)
  subjectUser    User?        @relation("SecurityAlertSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  actorUser      User?        @relation("SecurityAlertActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  acknowledgedBy User?        @relation("SecurityAlertAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  /// The rules' "already raised in this window" checks.
  @@index([tenantId, rule, createdAt])
  @@map("security_alerts")
}
