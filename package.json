{
  "name": "sentinel",
  "version": "0.1.0",
  "description": "Multi-tenant authorization and security compliance service",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postinstall": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "mail:up": "docker-compose up -d mailpit",
    "keys:generate": "node scripts/generate-jwt-key.mjs",
    "platform-admin:create": "node dist/platform/create-platform-admin"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/terminus": "11.1.1",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "jose": "5.10.0",
    "nodemailer": "10.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "eslint": "9.39.5",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
